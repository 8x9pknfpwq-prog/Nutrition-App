{
  "appId": "com.nyclines.app",
  "appName": "NYC Lines",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#F5F2EC"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#F5F2EC",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
