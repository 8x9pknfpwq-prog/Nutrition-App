# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lineup?schema=public"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"

# --- Server ---
PORT=3001
# Set NODE_ENV=production to serve the built client from the API server
NODE_ENV=development
# Origin allowed for CORS / Socket.io in dev (the Vite client)
CLIENT_ORIGIN="http://localhost:5173"

# --- Supabase (all-in-one backend: DB + Auth + Realtime) ---
# Frontend (safe to expose): project URL + anon/publishable key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Server-side secrets live in Supabase, NOT here:
#   - SUPABASE_SERVICE_ROLE_KEY and GOOGLE_MAPS_API_KEY are set on the
#     submit-place Edge Function via `supabase secrets set`.

# --- Frontend (Vite, must be prefixed with VITE_) ---
# Get a free token at https://account.mapbox.com/access-tokens/
# If omitted, the app falls back to a non-Mapbox schematic map so it still runs.
VITE_MAPBOX_TOKEN=""
